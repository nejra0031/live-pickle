{
  "rules": {
    ".read": true,

    "players":     { ".write": true },
    "players_e2e": { ".write": true },

    "tournamentsMeta":     { ".write": true },
    "tournamentsMeta_e2e": { ".write": true },

    "tournaments": {
      "$tid": {
        ".write": "auth != null && data.child('ownerUids/' + auth.uid).val() === true",
        "current":  { ".write": true },
        "backups":  { ".write": true },
        "presence": { ".write": true },
        "ownerUids": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('tournaments/' + $tid + '/ownerUids').exists() || root.child('tournaments/' + $tid + '/ownerUids/' + auth.uid).val() === true)"
          }
        },
        "config": {
          "adminPins":   { ".write": "auth != null && root.child('tournaments/' + $tid + '/ownerUids/' + auth.uid).val() === true" },
          "refereePins": { ".write": "auth != null && root.child('tournaments/' + $tid + '/ownerUids/' + auth.uid).val() === true" }
        }
      }
    },

    "tournaments_e2e": { ".write": true }
  }
}
